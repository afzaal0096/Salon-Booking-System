    {
      "parameters": {
        "jsCode": "// Get input parameters passed to this workflow\nconst inputData = $input.first().json;\nconst requestedDate = inputData.requested_date || \"2026-09-22\";\n\n// Mock provider working hours and service duration\nconst providerHours = [\"09:00-13:00\", \"14:00-17:00\"]; // Working shifts\nconst serviceDurationMinutes = 30; // e.g., Dental consultation\nconst bufferMinutes = 10; // Buffer between appointments\n\n// Helper to convert time string (HH:mm) to Minutes from midnight\nfunction timeToMinutes(timeStr) {\n    const [hours, minutes] = timeStr.split(':').map(Number);\n    return hours * 60 + minutes;\n}\n\n// Helper to convert minutes back to HH:mm format\nfunction minutesToTime(totalMinutes) {\n    const hours = Math.floor(totalMinutes / 60).toString().padStart(2, '0');\n    const minutes = (totalMinutes % 60).toString().padStart(2, '0');\n    return `${hours}:${minutes}`;\n}\n\n// Generate available slots based on shifts\nlet availableSlots = [];\n\nproviderHours.forEach(shift => {\n    const [startStr, endStr] = shift.split('-');\n    let currentMinutes = timeToMinutes(startStr);\n    const endMinutes = timeToMinutes(endStr);\n\n    while (currentMinutes + serviceDurationMinutes <= endMinutes) {\n        const slotStart = minutesToTime(currentMinutes);\n        currentMinutes += serviceDurationMinutes;\n        const slotEnd = minutesToTime(currentMinutes);\n\n        availableSlots.push({\n            date: requestedDate,\n            start_time: slotStart,\n            end_time: slotEnd,\n            formatted_slot: `${requestedDate} from ${slotStart} to ${slotEnd}`\n        });\n\n        // Add buffer time\n        currentMinutes += bufferMinutes;\n    }\n});\n\n// Return the next available slots\nreturn availableSlots.slice(0, 5).map(slot => ({ json: slot }));"
      },
